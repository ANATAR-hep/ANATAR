Cell[BoxData[{
 RowBox[{"ClearProcess", "[", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Process", "=", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"F", "[", 
       RowBox[{"4", ",", 
        RowBox[{"{", "1", "}"}]}], "]"}], ",", 
      RowBox[{"-", 
       RowBox[{"F", "[", 
        RowBox[{"4", ",", 
         RowBox[{"{", "1", "}"}]}], "]"}]}]}], "}"}], "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"F", "[", 
       RowBox[{"2", ",", 
        RowBox[{"{", "1", "}"}]}], "]"}], ",", 
      RowBox[{"-", 
       RowBox[{"F", "[", 
        RowBox[{"2", ",", 
         RowBox[{"{", "1", "}"}]}], "]"}]}]}], "}"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"top", "=", 
   RowBox[{"CreateTopologies", "[", 
    RowBox[{"0", ",", 
     RowBox[{"2", "\[Rule]", " ", "2"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"AA", "=", 
   RowBox[{"InsertFields", "[", 
    RowBox[{"top", ",", "Process", ",", 
     RowBox[{"InsertionLevel", "\[Rule]", " ", 
      RowBox[{"{", "Particles", "}"}]}], ",", 
     RowBox[{"ExcludeParticles", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"S", "[", "1", "]"}], ",", 
        RowBox[{"S", "[", "2", "]"}]}], "}"}]}]}], 
    RowBox[{"(*", 
     RowBox[{",", 
      RowBox[{"ExcludeFieldPoints", "->", 
       RowBox[{"{", 
        RowBox[{"FieldPoint", "[", 
         RowBox[{
          RowBox[{"V", "[", "3", "]"}], ",", 
          RowBox[{"-", 
           RowBox[{"V", "[", "3", "]"}]}], ",", 
          RowBox[{"V", "[", "2", "]"}], ",", 
          RowBox[{"V", "[", "2", "]"}]}], "]"}], "}"}]}]}], "*)"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Paint", "[", 
   RowBox[{"AA", ",", 
    RowBox[{"SheetHeader", "\[Rule]", "False"}], ",", 
    RowBox[{"ImageSize", "\[Rule]", "400"}]}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Amp0", "=", 
   RowBox[{
    RowBox[{"CreateFeynAmp", "[", "AA", "]"}], "//.", 
    RowBox[{"Subexpr", "[", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"res1", "=", 
   RowBox[{"CalcFeynAmp", "[", 
    RowBox[{"Amp0", ",", 
     RowBox[{"FermionChains", "\[Rule]", " ", "Chiral"}], ",", 
     RowBox[{"Dimension", "->", "D"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"_Hel", "=", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"FormCalcResultddee", "=", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"PolarizationSum", "[", 
      RowBox[{"res1", ",", "res1", ",", 
       RowBox[{"Dimension", "->", "D"}]}], "]"}], "//.", 
     RowBox[{"Subexpr", "[", "]"}]}], ")"}], "//", "FullSimplify", 
   " "}]}]}], "Input",
