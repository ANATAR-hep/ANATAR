Cell[BoxData[{
 RowBox[{
  RowBox[{"resultAnatar6", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"AmpSq6", "[", "Amplitudes", "]"}], "/.", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Den", "[", 
        RowBox[{"a_", ",", "b_"}], "]"}], ":>", 
       FractionBox["1", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Dot", "[", 
           RowBox[{"a", ",", "a"}], "]"}], "-", 
          SuperscriptBox["b", "2"]}], ")"}]]}], "}"}]}], "/.", 
    "AN$Kinematics"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Variables", "[", "resultAnatar6", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Cases", "[", 
    RowBox[{"%", ",", 
     RowBox[{"Dot", "[", 
      RowBox[{"a_", ",", "b_"}], "]"}], ",", "Infinity"}], "]"}], "//", 
   "DeleteDuplicates"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"%", "/.", "AN$Kinematics"}], "/.", 
        RowBox[{
         RowBox[{"Dot", "[", 
          RowBox[{"a_", ",", "b_"}], "]"}], ":>", 
         RowBox[{"Distribute", "[", 
          RowBox[{"Dot", "[", 
           RowBox[{"a", ",", "b"}], "]"}], "]"}]}]}], "/.", 
       RowBox[{
        RowBox[{"Dot", "[", 
         RowBox[{
          RowBox[{"-", "a_"}], ",", "b_"}], "]"}], ":>", 
        RowBox[{"-", 
         RowBox[{"Distribute", "[", 
          RowBox[{"Dot", "[", 
           RowBox[{"a", ",", "b"}], "]"}], "]"}]}]}]}], "/.", 
      RowBox[{
       RowBox[{"Dot", "[", 
        RowBox[{"a_", ",", 
         RowBox[{"-", "b_"}]}], "]"}], ":>", 
       RowBox[{"-", 
        RowBox[{"Distribute", "[", 
         RowBox[{"Dot", "[", 
          RowBox[{"a", ",", "b"}], "]"}], "]"}]}]}]}], "/.", 
     "AN$Kinematics"}], "/.", 
    RowBox[{
     RowBox[{"Dot", "[", 
      RowBox[{"a_", ",", "b_"}], "]"}], ":>", 
     RowBox[{"Dot", "[", 
      RowBox[{"b", ",", "a"}], "]"}]}]}], "/.", "AN$Kinematics"}], 
