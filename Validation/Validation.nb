              RowBox[{
               RowBox[{"FreeQ", "[", 
                RowBox[{"#", ",", 
                 RowBox[{"S", "|", "T", "|", "U"}]}], "]"}], "&"}], ")"}]}], 
            ")"}]}]}], "]"}]}]}], "&"}]}], "]"}]}], ";"}], "\n", 
