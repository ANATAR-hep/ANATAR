 RowBox[{
  RowBox[{"resultAnatar4", "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"AmpSq4", "[", "Amplitudes", "]"}], "/.", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Den", "[", 
            RowBox[{"a_", ",", "b_"}], "]"}], ":>", 
           FractionBox["1", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"Dot", "[", 
               RowBox[{"a", ",", "a"}], "]"}], "-", 
              SuperscriptBox["b", "2"]}], ")"}]]}], "}"}]}], "/.", 
        RowBox[{"{", 
         RowBox[{"sw2", ":>", 
          SuperscriptBox["sw", "2"]}], "}"}]}], "/.", "AN$Kinematics"}], "/.", 
      RowBox[{"{", 
       RowBox[{"U", "->", 
        RowBox[{
         RowBox[{"-", "S"}], "-", "T"}]}], "}"}]}], "/.", "DotSubs3"}], "//.", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       SuperscriptBox["cw", "8"], "->", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"1", "-", 
          SuperscriptBox["sw", "2"]}], ")"}], "4"]}], ",", 
      RowBox[{
