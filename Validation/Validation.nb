Cell[BoxData[{
 RowBox[{
  RowBox[{"AmpSq10", "[", "Kinematics", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"relevantRules", "=", 
   RowBox[{"Select", "[", 
    RowBox[{"%", ",", 
     RowBox[{
      RowBox[{
       RowBox[{"!", 
        RowBox[{"FreeQ", "[", 
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", "2", "]"}], "]"}], ",", 
          RowBox[{"S", "|", "T", "|", "U"}]}], "]"}]}], "&&", 
       RowBox[{"!", 
        RowBox[{"MatchQ", "[", 
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", "2", "]"}], "]"}], ",", 
          RowBox[{"1", "/", 
           RowBox[{"(", 
            RowBox[{"_", "?", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"FreeQ", "[", 
                RowBox[{"#", ",", 
                 RowBox[{"S", "|", "T", "|", "U"}]}], "]"}], "&"}], ")"}]}], 
            ")"}]}]}], "]"}]}]}], "&"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"equations", "=", 
   RowBox[{
    RowBox[{"Replace", "[", 
     RowBox[{"relevantRules", ",", 
      RowBox[{
