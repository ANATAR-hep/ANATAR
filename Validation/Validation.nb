       RowBox[{
        RowBox[{"\"\<QCD\>\"", "->", "\"\<Feynman\>\""}], ",", 
        RowBox[{"\"\<EW\>\"", "->", "\"\<Unitary\>\""}]}], "}"}]}], ",", 
