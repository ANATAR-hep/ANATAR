Cell[BoxData[
 RowBox[{
  RowBox[{"AmpC17", "=", 
   RowBox[{"GenerateAmplitudeConjugate", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"t", ",", "tbar"}], "}"}], "->", 
      RowBox[{"{", 
       RowBox[{"u", ",", "ubar"}], "}"}]}], ",", 
     RowBox[{"OutputName", "->", "\"\<ttbar_uubar\>\""}], ",", 
     RowBox[{"QGrafOptions", "->", "\"\<notadpole,nosnail,onshell\>\""}], ",", 
     RowBox[{"CouplingsOrder", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"gs", ",", "0", ",", "4"}], "}"}], ",", 
        RowBox[{"{", 
