Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"AmpSq4", "[", "Kinematics", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"relevantRules", "=", 
   RowBox[{"Select", "[", 
    RowBox[{
     RowBox[{"AmpSq4", "[", "Kinematics", "]"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"!", 
        RowBox[{"FreeQ", "[", 
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", "2", "]"}], "]"}], ",", 
          RowBox[{"S", "|", "T", "|", "U"}]}], "]"}]}], "&&", 
       RowBox[{"!", 
        RowBox[{"MatchQ", "[", 
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", "2", "]"}], "]"}], ",", 
          RowBox[{"1", "/", 
           RowBox[{"(", 
            RowBox[{"_", "?", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"FreeQ", "[", 
                RowBox[{"#", ",", 
                 RowBox[{"S", "|", "T", "|", "U"}]}], "]"}], "&"}], ")"}]}], 
            ")"}]}]}], "]"}]}]}], "&"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"equations", "=", 
   RowBox[{
    RowBox[{"Replace", "[", 
     RowBox[{"relevantRules", ",", 
      RowBox[{
       RowBox[{"Rule", "[", 
        RowBox[{"lhs_", ",", "rhs_"}], "]"}], ":>", 
       RowBox[{"lhs", "==", "rhs"}]}], ",", 
      RowBox[{"{", "1", "}"}]}], "]"}], "[", 
    RowBox[{"[", 
     RowBox[{"1", ";;", "3"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{"STURules", "=", 
  RowBox[{"Solve", "[", 
   RowBox[{"equations", ",", 
    RowBox[{"{", 
     RowBox[{"S", ",", "T", ",", "U"}], "}"}]}], 
   "]"}]}], "\[IndentingNewLine]"}], "Input",
