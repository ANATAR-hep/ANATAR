Cell[BoxData[
 FormBox[
  RowBox[{"\[LeftAssociation]", 
   RowBox[{
    RowBox[{"Process", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"d", "(", "p1", ")"}], ",", 
         RowBox[{"dbar", "(", "p2", ")"}]}], "}"}], "\[Rule]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"t", "(", "p3", ")"}], ",", 
         RowBox[{"tbar", "(", "p4", ")"}]}], "}"}]}], "}"}]}], ",", 
    RowBox[{"Total", "\[Rule]", "3"}], ",", 
    RowBox[{"Name", "\[Rule]", "\<\"ddtt\"\>"}], ",", 
    RowBox[{"LoopOrder", "\[Rule]", "0"}], ",", 
    RowBox[{"Kinematics", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        SuperscriptBox["p1", "2"], "\[Rule]", "0"}], ",", 
       RowBox[{
        RowBox[{"p1", ".", "p1"}], "\[Rule]", "0"}], ",", 
       RowBox[{
        SuperscriptBox["p2", "2"], "\[Rule]", "0"}], ",", 
       RowBox[{
        RowBox[{"p2", ".", "p2"}], "\[Rule]", "0"}], ",", 
       RowBox[{
        SuperscriptBox["p3", "2"], "\[Rule]", 
        SuperscriptBox["MT", "2"]}], ",", 
       RowBox[{
        RowBox[{"p3", ".", "p3"}], "\[Rule]", 
        SuperscriptBox["MT", "2"]}], ",", 
       RowBox[{
        FractionBox["1", 
         RowBox[{"p3", ".", "p3"}]], "\[Rule]", 
        FractionBox["1", 
         SuperscriptBox["MT", "2"]]}], ",", 
       RowBox[{
        SuperscriptBox["p4", "2"], "\[Rule]", 
        SuperscriptBox["MT", "2"]}], ",", 
       RowBox[{
        RowBox[{"p4", ".", "p4"}], "\[Rule]", 
        SuperscriptBox["MT", "2"]}], ",", 
       RowBox[{
        FractionBox["1", 
         RowBox[{"p4", ".", "p4"}]], "\[Rule]", 
        FractionBox["1", 
         SuperscriptBox["MT", "2"]]}], ",", 
       RowBox[{
        RowBox[{"p1", ".", "p2"}], "\[Rule]", 
        FractionBox["S", "2"]}], ",", 
       RowBox[{
        RowBox[{"p1", ".", "p3"}], "\[Rule]", 
        RowBox[{
         FractionBox["1", "2"], " ", 
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["MT", "2"], "-", "T"}], ")"}]}]}], ",", 
       RowBox[{
        RowBox[{"p2", ".", "p3"}], "\[Rule]", 
        RowBox[{
         FractionBox["1", "2"], " ", 
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["MT", "2"], "-", "U"}], ")"}]}]}], ",", 
