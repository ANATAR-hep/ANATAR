 FormBox[
  RowBox[{"\[LeftAssociation]", 
   RowBox[{
    RowBox[{"Process", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"d", "(", "p1", ")"}], ",", 
         RowBox[{"dbar", "(", "p2", ")"}]}], "}"}], "\[Rule]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"d", "(", "p3", ")"}], ",", 
         RowBox[{"dbar", "(", "p4", ")"}]}], "}"}]}], "}"}]}], ",", 
    RowBox[{"Total", "\[Rule]", "6"}], ",", 
    RowBox[{"Name", "\[Rule]", "\<\"dddd\"\>"}], ",", 
    RowBox[{"LoopOrder", "\[Rule]", "0"}], ",", 
    RowBox[{"Kinematics", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        SuperscriptBox["p1", "2"], "\[Rule]", "0"}], ",", 
       RowBox[{
        RowBox[{"p1", ".", "p1"}], "\[Rule]", "0"}], ",", 
       RowBox[{
        SuperscriptBox["p2", "2"], "\[Rule]", "0"}], ",", 
       RowBox[{
        RowBox[{"p2", ".", "p2"}], "\[Rule]", "0"}], ",", 
       RowBox[{
        SuperscriptBox["p3", "2"], "\[Rule]", "0"}], ",", 
       RowBox[{
        RowBox[{"p3", ".", "p3"}], "\[Rule]", "0"}], ",", 
       RowBox[{
        SuperscriptBox["p4", "2"], "\[Rule]", "0"}], ",", 
       RowBox[{
        RowBox[{"p4", ".", "p4"}], "\[Rule]", "0"}], ",", 
