Cell[BoxData[
 FormBox[
  RowBox[{"\[LeftAssociation]", 
   RowBox[{
    RowBox[{"Process", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"u", "(", "p1", ")"}], ",", 
         RowBox[{"ubar", "(", "p2", ")"}]}], "}"}], "\[Rule]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"s", "(", "p3", ")"}], ",", 
         RowBox[{"sbar", "(", "p4", ")"}]}], "}"}]}], "}"}]}], ",", 
    RowBox[{"Total", "\[Rule]", "3"}], ",", 
    RowBox[{"Name", "\[Rule]", "\<\"uuss\"\>"}], ",", 
    RowBox[{"LoopOrder", "\[Rule]", "0"}], ",", 
    RowBox[{"Kinematics", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        SuperscriptBox["p1", "2"], "\[Rule]", "0"}], ",", 
       RowBox[{
        RowBox[{"p1", ".", "p1"}], "\[Rule]", "0"}], ",", 
       RowBox[{
        SuperscriptBox["p2", "2"], "\[Rule]", "0"}], ",", 
       RowBox[{
        RowBox[{"p2", ".", "p2"}], "\[Rule]", "0"}], ",", 
       RowBox[{
        SuperscriptBox["p3", "2"], "\[Rule]", "0"}], ",", 
       RowBox[{
        RowBox[{"p3", ".", "p3"}], "\[Rule]", "0"}], ",", 
       RowBox[{
        SuperscriptBox["p4", "2"], "\[Rule]", "0"}], ",", 
       RowBox[{
        RowBox[{"p4", ".", "p4"}], "\[Rule]", "0"}], ",", 
       RowBox[{
        RowBox[{"p1", ".", "p2"}], "\[Rule]", 
        FractionBox["S", "2"]}], ",", 
       RowBox[{
        RowBox[{"p1", ".", "p3"}], "\[Rule]", 
        RowBox[{"-", 
         FractionBox["T", "2"]}]}], ",", 
       RowBox[{
        RowBox[{"p2", ".", "p3"}], "\[Rule]", 
        RowBox[{"-", 
         FractionBox["U", "2"]}]}], ",", 
       RowBox[{
        FractionBox["1", 
         RowBox[{"p1", ".", "p2"}]], "\[Rule]", 
        FractionBox["2", "S"]}], ",", 
       RowBox[{
        FractionBox["1", 
         RowBox[{"p1", ".", "p3"}]], "\[Rule]", 
        RowBox[{"-", 
         FractionBox["2", "T"]}]}], ",", 
       RowBox[{
        FractionBox["1", 
         RowBox[{"p2", ".", "p3"}]], "\[Rule]", 
        RowBox[{"-", 
         FractionBox["2", "U"]}]}], ",", 
       RowBox[{"p4", "\[Rule]", 
        RowBox[{"p1", "+", "p2", "-", "p3"}]}]}], "}"}]}], ",", 
    RowBox[{"Amplitudes", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"DiagramID", "(", "1", ")"}], "\[Rule]", 
        RowBox[{"\[ImaginaryI]", " ", "GC1", " ", "GC2", " ", 
         RowBox[{"Den", "(", 
          RowBox[{
           RowBox[{
            RowBox[{"-", "p1"}], "-", "p2"}], ",", "0"}], ")"}], " ", 
         SubscriptBox[
          RowBox[{"(", 
           SuperscriptBox["\[Gamma]", "iLor2"], ")"}], 
          RowBox[{
           StyleBox["Spin1",
            FontSlant->"Italic"], " ", 
           StyleBox["Spin3",
            FontSlant->"Italic"]}]], " ", 
         SubscriptBox[
          RowBox[{"(", 
           SuperscriptBox["\[Gamma]", "iLor2"], ")"}], 
          RowBox[{
           StyleBox["Spin2",
            FontSlant->"Italic"], " ", 
           StyleBox["Spin4",
            FontSlant->"Italic"]}]], " ", 
         RowBox[{
          SubsuperscriptBox[
           OverscriptBox["v", "_"], 
           StyleBox["Spin3",
            FontSlant->"Italic"], "Colour3"], "(", "p2", ",", "0", ")"}], " ", 
         RowBox[{
          SubsuperscriptBox["u", 
           StyleBox["Spin1",
            FontSlant->"Italic"], "Colour3"], "(", "p1", ",", "0", ")"}], " ", 
         RowBox[{
          SubsuperscriptBox[
           OverscriptBox["u", "_"], 
           StyleBox["Spin2",
            FontSlant->"Italic"], "Colour4"], "(", "p3", ",", "0", ")"}], " ", 
         RowBox[{
          SubsuperscriptBox["v", 
           StyleBox["Spin4",
            FontSlant->"Italic"], "Colour4"], "(", "p4", ",", "0", ")"}]}]}], 
       ",", 
       RowBox[{
        RowBox[{"DiagramID", "(", "2", ")"}], "\[Rule]", 
        RowBox[{
         FractionBox["1", "4"], " ", "\[ImaginaryI]", " ", 
         RowBox[{"Den", "(", 
          RowBox[{
           RowBox[{
            RowBox[{"-", "p1"}], "-", "p2"}], ",", "MZ"}], ")"}], " ", 
         RowBox[{
          SubsuperscriptBox[
           OverscriptBox["v", "_"], 
           StyleBox["Spin3",
            FontSlant->"Italic"], "Colour3"], "(", "p2", ",", "0", ")"}], " ", 
         RowBox[{
          SubsuperscriptBox["u", 
           StyleBox["Spin1",
            FontSlant->"Italic"], "Colour3"], "(", "p1", ",", "0", ")"}], " ", 
         RowBox[{
          SubsuperscriptBox[
           OverscriptBox["u", "_"], 
           StyleBox["Spin2",
            FontSlant->"Italic"], "Colour4"], "(", "p3", ",", "0", ")"}], " ", 
         RowBox[{
          SubsuperscriptBox["v", 
           StyleBox["Spin4",
            FontSlant->"Italic"], "Colour4"], "(", "p4", ",", "0", ")"}], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"GC34", "-", "GC13"}], ")"}], " ", 
            SubscriptBox[
             RowBox[{"(", 
              RowBox[{
               SuperscriptBox["\[Gamma]", "iLor2"], 
               SuperscriptBox["\[Gamma]", "5"]}], ")"}], 
             RowBox[{
              StyleBox["Spin2",
               FontSlant->"Italic"], " ", 
              StyleBox["Spin4",
               FontSlant->"Italic"]}]]}], "+", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"GC13", "+", "GC34"}], ")"}], " ", 
            SubscriptBox[
             RowBox[{"(", 
              SuperscriptBox["\[Gamma]", "iLor2"], ")"}], 
             RowBox[{
              StyleBox["Spin2",
               FontSlant->"Italic"], " ", 
              StyleBox["Spin4",
               FontSlant->"Italic"]}]]}]}], ")"}], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"GC26", "+", 
              RowBox[{"5", " ", "GC33"}]}], ")"}], " ", 
            SubscriptBox[
             RowBox[{"(", 
              SuperscriptBox["\[Gamma]", "iLor2"], ")"}], 
             RowBox[{
              StyleBox["Spin1",
               FontSlant->"Italic"], " ", 
              StyleBox["Spin3",
               FontSlant->"Italic"]}]]}], "-", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"GC26", "-", 
              RowBox[{"3", " ", "GC33"}]}], ")"}], " ", 
            SubscriptBox[
             RowBox[{"(", 
              RowBox[{
               SuperscriptBox["\[Gamma]", "iLor2"], 
               SuperscriptBox["\[Gamma]", "5"]}], ")"}], 
             RowBox[{
              StyleBox["Spin1",
               FontSlant->"Italic"], " ", 
              StyleBox["Spin3",
               FontSlant->"Italic"]}]]}]}], ")"}]}]}], ",", 
       RowBox[{
        RowBox[{"DiagramID", "(", "3", ")"}], "\[Rule]", 
        RowBox[{"\[ImaginaryI]", " ", 
         SuperscriptBox["GC10", "2"], " ", 
         RowBox[{"Den", "(", 
          RowBox[{
           RowBox[{
            RowBox[{"-", "p1"}], "-", "p2"}], ",", "0"}], ")"}], " ", 
         SubsuperscriptBox["T", 
          StyleBox[
           RowBox[{"Colour3", "Colour1"}],
           FontSlant->"Italic"], "iGluon2"], " ", 
         SubsuperscriptBox["T", 
          StyleBox[
           RowBox[{"Colour2", "Colour4"}],
           FontSlant->"Italic"], "iGluon2"], " ", 
         SubscriptBox[
          RowBox[{"(", 
           SuperscriptBox["\[Gamma]", "iLor2"], ")"}], 
          RowBox[{
           StyleBox["Spin1",
            FontSlant->"Italic"], " ", 
           StyleBox["Spin3",
            FontSlant->"Italic"]}]], " ", 
         SubscriptBox[
          RowBox[{"(", 
           SuperscriptBox["\[Gamma]", "iLor2"], ")"}], 
          RowBox[{
           StyleBox["Spin2",
            FontSlant->"Italic"], " ", 
           StyleBox["Spin4",
            FontSlant->"Italic"]}]], " ", 
         RowBox[{
          SubsuperscriptBox["u", 
           StyleBox["Spin1",
            FontSlant->"Italic"], "Colour1"], "(", "p1", ",", "0", ")"}], " ", 
         RowBox[{
          SubsuperscriptBox[
           OverscriptBox["u", "_"], 
           StyleBox["Spin2",
            FontSlant->"Italic"], "Colour2"], "(", "p3", ",", "0", ")"}], " ", 
         RowBox[{
          SubsuperscriptBox[
           OverscriptBox["v", "_"], 
           StyleBox["Spin3",
            FontSlant->"Italic"], "Colour3"], "(", "p2", ",", "0", ")"}], " ", 
         RowBox[{
          SubsuperscriptBox["v", 
           StyleBox["Spin4",
            FontSlant->"Italic"], "Colour4"], "(", "p4", ",", "0", 
          ")"}]}]}]}], "}"}]}]}], "\[RightAssociation]"}], 
  TraditionalForm]], "Output",
 CellChangeTimes->{{3.9633796138799148`*^9, 3.963379623325921*^9}, {
