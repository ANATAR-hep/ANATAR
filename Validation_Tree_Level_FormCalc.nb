        FractionBox["1", 
         RowBox[{"p1", ".", "p3"}]], "\[Rule]", 
        FractionBox["2", 
         RowBox[{
          SuperscriptBox["MT", "2"], "-", "T"}]]}], ",", 
       RowBox[{
        FractionBox["1", 
         RowBox[{"p2", ".", "p3"}]], "\[Rule]", 
        FractionBox["2", 
         RowBox[{
          SuperscriptBox["MT", "2"], "-", "U"}]]}], ",", 
       RowBox[{"p4", "\[Rule]", 
        RowBox[{"p1", "+", "p2", "-", "p3"}]}]}], "}"}]}], ",", 
    RowBox[{"Amplitudes", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"DiagramID", "(", "1", ")"}], "\[Rule]", 
